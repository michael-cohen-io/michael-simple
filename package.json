{
  "name": "michael-simple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "predev": "bun run generate",
    "dev": "next dev",
    "prebuild": "bun run generate",
    "build": "next build",
    "postbuild": "bun scripts/check-paths.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "generate": "bun run resume:pdf && bun run llms",
    "resume:pdf": "bun scripts/build-resume.tsx",
    "llms": "bun scripts/build-llms.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@base-ui/react": "1.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.7",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
